---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import {
  type BlogPost,
  buildAreaBlogGroups,
  getOtherBlogPosts,
  getPostUrl,
  isPublishedPost,
  sortPostsByNewest,
} from '../../lib/blogListing';
import { canonicalUrl } from '../../lib/site';
import { resolveBlogMeta, resolvePostImage } from '../../lib/blogSeo';

const allPosts = sortPostsByNewest(
  (await getCollection('blog')).filter(isPublishedPost),
);
const areaGroups = buildAreaBlogGroups(allPosts);
const otherPosts = getOtherBlogPosts(allPosts);

function cardData(post: BlogPost) {
  const slug = post.id.replace(/\/index$/, '');
  const formattedDate = new Date(post.data.date).toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).replace(/\//g, '.');
  const { description } = resolveBlogMeta(post);
  return {
    url: getPostUrl(post),
    image: resolvePostImage(post.data.coverImage, slug) ?? resolvePostImage(post.data.ogp?.og_image, slug),
    formattedDate,
    description,
    title: post.data.title,
    areaName: post.data.areaName,
  };
}
---

<BlogLayout
  title="ブログ一覧"
  description="愛知県三河・名古屋のフロントガラス飛び石修理専門店によるお役立ちブログ一覧。ヒビ割れの応急処置や車検基準などについてプロが分かりやすく解説します。"
  canonical={canonicalUrl('/blog')}
  ogType="website"
>
  
  <!-- ===== HERO SECTION ===== -->
  <section class="blog-hero">
    <div class="container">
      <div class="blog-hero-content">
        <span class="blog-hero-tag">プロが教えるフロントガラス豆知識</span>
        <h1 class="blog-hero-title">フロントガラス修理ブログ</h1>
        <p class="blog-hero-lead">飛び石ヒビの応急処置から、高額な交換費用を避けるためのコツまで、地域のドライバー様に役立つ情報を分かりやすくお届けします。</p>
      </div>
    </div>
  </section>

  <!-- ===== CATALOG SECTION ===== -->
  <section class="blog-catalog section-light">
    <div class="container">
      
      {areaGroups.map((group) => (
        <section class="blog-area-section" data-area-id={group.areaId}>
          <h2 class="blog-area-heading">📍 {group.areaName}</h2>
          <div class="blog-grid">
            {group.posts.map((post) => {
              const card = cardData(post);
              return (
                <article class="blog-post-card">
                  <a href={card.url} class="card-link">
                    <div class="card-image-wrap">
                      {card.image ? (
                        <img src={card.image} alt={card.title} loading="lazy" />
                      ) : (
                        <div class="card-image-fallback">No Image</div>
                      )}
                    </div>
                    <div class="card-body">
                      <div class="card-meta">
                        <span class="card-date">🕒 {card.formattedDate}</span>
                        {card.areaName && <span class="card-area">{card.areaName}</span>}
                      </div>
                      <h2 class="card-title">{card.title}</h2>
                      <p class="card-excerpt">{card.description}</p>
                      <span class="card-more">記事を読む →</span>
                    </div>
                  </a>
                </article>
              );
            })}
          </div>
        </section>
      ))}

      {otherPosts.length > 0 && (
        <section class="blog-area-section">
          <h2 class="blog-area-heading">📘 お役立ち情報</h2>
          <div class="blog-grid">
            {otherPosts.map((post) => {
              const card = cardData(post);
              return (
                <article class="blog-post-card">
                  <a href={card.url} class="card-link">
                    <div class="card-image-wrap">
                      {card.image ? (
                        <img src={card.image} alt={card.title} loading="lazy" />
                      ) : (
                        <div class="card-image-fallback">No Image</div>
                      )}
                    </div>
                    <div class="card-body">
                      <div class="card-meta">
                        <span class="card-date">🕒 {card.formattedDate}</span>
                      </div>
                      <h2 class="card-title">{card.title}</h2>
                      <p class="card-excerpt">{card.description}</p>
                      <span class="card-more">記事を読む →</span>
                    </div>
                  </a>
                </article>
              );
            })}
          </div>
        </section>
      )}

    </div>
  </section>

  <!-- ===== LP LINK / CTA SECTION ===== -->
  <section class="blog-cta section-accent">
    <div class="container">
      <div class="blog-cta-box">
        <h2>飛び石のヒビ・割れでお悩みですか？</h2>
        <p>「ディーラーで交換と言われて高すぎる」「今日中に直したい」「車検に通るか不安」<br>三河・名古屋エリアの出張フロントガラス修理専門店にお任せください。最短30分で完了します。</p>
        
        <div class="tokuten-box tokuten-light">
          <div class="tokuten-label">📣 期間限定プレゼント</div>
          <p class="tokuten-text">ご施工のお客様全員に <strong>車内 内窓 純水で拭き上げ</strong> を無料でプレゼント！</p>
        </div>

        <div class="blog-cta-group">
          <a href="tel:07084280866" class="btn-primary">
            <span class="btn-icon">📞</span>今すぐ無料電話相談する
            <span class="btn-sub">24時間・年中無休受付</span>
          </a>
          <a href="https://lin.ee/Qvq5293" class="btn-line" target="_blank" rel="noopener">
            <span class="btn-icon">💬</span>LINEで写真を送って無料見積もり
          </a>
        </div>
        
        <div class="lp-link-wrap">
          <a href="/aichi" class="btn-lp-link">出張修理の料金や施工実績を詳しく見る（LPトップへ）</a>
        </div>
      </div>
    </div>
  </section>

</BlogLayout>

<style>
  /* ブログ一覧ページの専用スタイル */
  .blog-hero {
    background: linear-gradient(135deg, #0D3D7A 0%, #1A5FAB 100%);
    color: #fff;
    padding: 80px 0;
    text-align: center;
  }
  .blog-hero-content {
    max-width: 760px;
    margin: 0 auto;
  }
  .blog-hero-tag {
    display: inline-block;
    background: rgba(255, 255, 255, 0.15);
    color: #FFD54F;
    font-size: 13px;
    font-weight: 700;
    padding: 6px 16px;
    border-radius: 40px;
    margin-bottom: 16px;
    letter-spacing: 0.05em;
  }
  .blog-hero-title {
    font-size: clamp(28px, 5vw, 44px);
    font-weight: 900;
    margin-bottom: 16px;
    line-height: 1.3;
  }
  .blog-hero-lead {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.7;
  }

  .blog-catalog {
    padding: 60px 0 80px;
  }
  .blog-area-section {
    margin-bottom: 48px;
  }
  .blog-area-heading {
    font-size: clamp(20px, 3vw, 26px);
    font-weight: 900;
    color: var(--blue-d);
    margin-bottom: 20px;
    padding-bottom: 8px;
    border-bottom: 2px solid #E8EFF8;
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 30px;
  }
  
  .blog-post-card {
    background: #fff;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 0.25s, box-shadow 0.25s;
    border: 1px solid #E8EFF8;
    display: flex;
    flex-direction: column;
  }
  .blog-post-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
  }
  
  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
  }
  
  .card-image-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #EAF2FB;
    position: relative;
  }
  .card-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .blog-post-card:hover .card-image-wrap img {
    transform: scale(1.05);
  }
  .card-image-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gray-l);
    font-weight: bold;
  }

  .card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .card-meta {
    margin-bottom: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .card-date {
    font-size: 12px;
    color: var(--gray);
    font-weight: 500;
  }
  .card-area {
    font-size: 11px;
    font-weight: 700;
    color: #92400e;
    background: #fef3c7;
    border-radius: 999px;
    padding: 2px 8px;
  }
  .card-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--dark);
    margin-bottom: 12px;
    line-height: 1.45;
  }
  .card-excerpt {
    font-size: 14px;
    color: var(--gray);
    line-height: 1.6;
    margin-bottom: 16px;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-more {
    font-size: 13px;
    font-weight: 700;
    color: var(--blue);
  }

  /* CTA */
  .blog-cta {
    padding: 70px 0;
    text-align: center;
    color: #fff;
  }
  .blog-cta-box {
    max-width: 780px;
    margin: 0 auto;
  }
  .blog-cta-box h2 {
    font-size: clamp(24px, 4vw, 36px);
    font-weight: 900;
    margin-bottom: 16px;
  }
  .blog-cta-box p {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.7;
    margin-bottom: 30px;
  }
  .blog-cta-box .tokuten-box {
    max-width: 480px;
    margin: 0 auto 30px;
    text-align: left;
  }
  .blog-cta-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
    margin-bottom: 36px;
  }
  .blog-cta-group .btn-primary, .blog-cta-group .btn-line {
    max-width: 440px;
  }
  
  .lp-link-wrap {
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 24px;
  }
  .btn-lp-link {
    display: inline-block;
    color: #FFD54F;
    font-weight: 700;
    font-size: 15px;
    text-decoration: underline;
  }
  .btn-lp-link:hover {
    color: #fff;
  }
</style>
